# Read by BigWigsMods/packager in .github/workflows/release.yml.
# The repository root is the addon folder, so package-as only names the folder the zip
# unpacks to. It must be Altoholic, or the client won't list the addon.
package-as: Altoholic

# The release workflow writes this file from this version's section of CHANGELOG.md.
# Without it the packager uses the whole commit log as the release notes.
manual-changelog:
    filename: RELEASE_NOTES.md
    markup-type: markdown

# Files players don't need in their AddOns folder.
ignore:
    - .github
    - .gitignore
    - .gitattributes
    - tools
    - CLAUDE.md
    - Screenshots
    - make-altoholic-links.ps
    - private
