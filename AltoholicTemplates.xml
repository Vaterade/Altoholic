<Ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.blizzard.com/wow/ui/">
	<!-- Item template -->
	<Button name="BagItemTemplate" inherits="ItemButtonTemplate" hidden="true" virtual="true">
		<Anchors>
			<Anchor point="BOTTOMRIGHT">
				<Offset>
					<AbsDimension x="0" y="0"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Scripts>
			<OnLoad>
				this:RegisterForClicks("LeftButtonDown", "RightButtonDown");
			</OnLoad>
			<OnEnter>
				Altoholic:Item_OnEnter(this, this:GetParent():GetID(), this:GetID())
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide();
			</OnLeave>
			<OnClick>
				Altoholic:Item_OnClick(this, arg1)
			</OnClick>
		</Scripts>
	</Button>
	<!-- Navigation: a plain menu row, styled after pfUI's config window. The rows are
	     AltoholicCategory1-10 (first column) and AltoholicMenuRow1-15 (second column);
	     Altoholic.lua sets their text, indent and click handler. -->
	<Button name="AltoMenuRowTemplate" hidden="true" virtual="true">
		<Size>
			<AbsDimension x="116" y="20"/>
		</Size>
		<Layers>
			<Layer level="BACKGROUND">
				<!-- the selected row; Altoholic:MenuRow_SetSelected fades it in from the left -->
				<Texture name="$parentSelected" hidden="true" setAllPoints="true">
					<Color r="1" g="1" b="1" a="1"/>
				</Texture>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture setAllPoints="true">
					<Color r="1" g="1" b="1" a="0.05"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString name="$parentText" inherits="GameFontHighlightSmall">
					<Anchors>
						<Anchor point="LEFT"/>
						<Anchor point="RIGHT"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick>
				Altoholic:MenuRow_OnClick(this)
			</OnClick>
		</Scripts>
	</Button>

</Ui>